datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
  DELIVERY_FAILED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum NailLength {
  SHORT
  MEDIUM
  LONG
  EXTRA_LONG
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CustomOrderStatus {
  SUBMITTED
  NEED_INFO
  REJECTED
  QUOTED
  ACCEPTED
  DECLINED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum EmailType {
  ORDER_RECEIVED
  PAYMENT_RESULT
  ORDER_STATUS_CHANGED
  CUSTOM_DESIGN_UPDATE
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NailSize {
  XS
  S
  M
  L
  CUSTOM
}

enum NailShape {
  ALMOND
  COFFIN
  SQUARE
  STILETTO
  ROUND
}

// ---------------------------------------------------------------------
// 1. NGƯỜI DÙNG, PHIÊN ĐĂNG NHẬP, ĐỊA CHỈ  (FR-01, FR-02, FR-03, FR-13)
// ---------------------------------------------------------------------

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String?   @map("full_name")
  phone        String?   @db.VarChar(20)
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true) @map("is_active")
  lockedReason String?   @map("locked_reason") @db.Text
  lockedAt     DateTime? @map("locked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cart                Cart?
  addresses           Address[]
  sessions            Session[]
  orders              Order[]
  customOrders        CustomOrder[]
  customOrderMessages CustomOrderMessage[]
  couponUsages        CouponUsage[]
  emailLogs           EmailLog[]
  verifiedPayments    Payment[]            @relation("PaymentVerifier")
  statusChanges       OrderStatusHistory[] @relation("StatusChangedBy")
  appointments        Appointment[]
  reviews             Review[]

  @@map("users")
}

model Session {
  id        String   @id @db.VarChar(64)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String   @map("csrf_token") @db.VarChar(128)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @db.VarChar(20)
  province      String   @db.VarChar(100)
  district      String   @db.VarChar(100)
  ward          String   @db.VarChar(100)
  addressLine   String   @map("address_line") @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------
// 2. SẢN PHẨM, ẢNH, BỘ SƯU TẬP  (FR-04, FR-05, FR-06, FR-12)
// ---------------------------------------------------------------------

model Product {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  slug        String        @unique
  description String?       @db.Text

  story            String?  @db.Text
  colorPalette     String[] @map("color_palette")
  craftTechnique   String?  @map("craft_technique") @db.Text
  careInstructions String?  @map("care_instructions") @db.Text

  shapeOptions  NailShape[]  @map("shape_options")
  lengthOptions NailLength[] @map("length_options")

  price       Decimal       @db.Decimal(12, 0)
  stock       Int           @default(0)
  isFeatured  Boolean       @default(false) @map("is_featured")

  status      ProductStatus @default(ACTIVE)
  releasedAt  DateTime      @default(now()) @map("released_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  images      ProductImage[]
  collections CollectionProduct[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([price])
  @@index([isFeatured])
  @@index([status, releasedAt])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String  @map("image_url")
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")
  altText   String? @map("alt_text") @db.VarChar(255)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Collection {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  slug        String   @unique
  description String?  @db.Text
  coverImage  String?  @map("cover_image")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products CollectionProduct[]

  @@index([isActive, sortOrder])
  @@map("collections")
}

model CollectionProduct {
  collectionId Int        @map("collection_id")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    Int        @map("product_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0) @map("sort_order")

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

// ---------------------------------------------------------------------
// 3. GIỎ HÀNG  (FR-09)
// ---------------------------------------------------------------------

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        Int        @id @default(autoincrement())
  cartId    Int        @map("cart_id")
  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int        @map("product_id")
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  shape     NailShape
  length    NailLength
  quantity  Int        @default(1)

  @@unique([cartId, productId, shape, length])
  @@index([productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------
// 4. ĐƠN HÀNG, CHI TIẾT, LỊCH SỬ TRẠNG THÁI  (FR-10, FR-13)
// ---------------------------------------------------------------------

model Order {
  id     Int         @id @default(autoincrement())
  orderCode String   @unique @map("order_code") @db.VarChar(20)
  userId Int         @map("user_id")
  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey String @map("idempotency_key") @db.VarChar(64)
  customOrderId Int?        @unique @map("custom_order_id")
  customOrder   CustomOrder? @relation(fields: [customOrderId], references: [id], onDelete: Restrict)

  status  OrderStatus @default(PENDING)

  recipientName   String @map("recipient_name") @db.VarChar(100)
  recipientPhone  String @map("recipient_phone") @db.VarChar(20)
  contactEmail    String @map("contact_email")
  shippingAddress String @map("shipping_address") @db.Text
  note            String? @db.Text

  subtotal       Decimal @db.Decimal(12, 0)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 0)
  shippingFee    Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 0)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 0)
  couponCode     String? @map("coupon_code") @db.VarChar(50)

  cancelReason String?   @map("cancel_reason") @db.Text
  cancelledAt  DateTime? @map("cancelled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  orderItems    OrderItem[]
  payments      Payment[]
  couponUsage   CouponUsage?
  statusHistory OrderStatusHistory[]
  emailLogs     EmailLog[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int     @map("product_id")
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String     @map("product_name") @db.VarChar(255)
  shape       NailShape
  length      NailLength
  quantity    Int
  price       Decimal @db.Decimal(12, 0)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int          @map("order_id")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById Int?         @map("changed_by_id")
  changedBy   User?        @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  note        String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------
// 5. THANH TOÁN VÀ ĐỐI SOÁT  (FR-11)
// ---------------------------------------------------------------------

model Payment {
  id      Int           @id @default(autoincrement())
  orderId Int           @map("order_id")
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)
  amount  Decimal       @db.Decimal(12, 0)

  momoOrderId    String? @unique @map("momo_order_id") @db.VarChar(64)
  momoRequestId  String? @map("momo_request_id") @db.VarChar(64)
  momoTransId    String? @unique @map("momo_trans_id") @db.VarChar(64)
  momoResultCode Int?    @map("momo_result_code")
  payUrl         String? @map("pay_url") @db.Text
  gatewayPayload Json?   @map("gateway_payload")

  transferReference String? @map("transfer_reference") @db.VarChar(100)
  receiptImage      String? @map("receipt_image")
  receiptMimeType   String? @map("receipt_mime_type") @db.VarChar(50)
  receiptSizeBytes  Int?    @map("receipt_size_bytes")
  receiptUploadedAt DateTime? @map("receipt_uploaded_at")

  verifiedById     Int?      @map("verified_by_id")
  verifiedBy       User?     @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt       DateTime? @map("verified_at")
  verificationNote String?   @map("verification_note") @db.Text

  paidAt        DateTime? @map("paid_at")
  failureReason String?   @map("failure_reason") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@index([method, status])
  @@map("payments")
}

// ---------------------------------------------------------------------
// 6. KHUYẾN MÃI  (FR-10, FR-15, mục 3.4)
// ---------------------------------------------------------------------

model Coupon {
  id              Int          @id @default(autoincrement())
  code            String       @unique @db.VarChar(50)
  description     String?      @db.VarChar(255)
  discountType    DiscountType @map("discount_type")
  discountValue   Decimal      @map("discount_value") @db.Decimal(12, 0)
  maxDiscount     Decimal?     @map("max_discount") @db.Decimal(12, 0)
  minOrderAmount  Decimal?     @map("min_order_amount") @db.Decimal(12, 0)
  startsAt        DateTime?    @map("starts_at")
  endsAt          DateTime?    @map("ends_at")
  usageLimit      Int?         @map("usage_limit")
  perUserLimit    Int?         @map("per_user_limit")
  usedCount       Int          @default(0) @map("used_count")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@index([isActive, endsAt])
  @@map("coupons")
}

model CouponUsage {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId         Int      @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId        Int      @unique @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([couponId])
  @@index([userId, couponId])
  @@map("coupon_usages")
}

// ---------------------------------------------------------------------
// 7. YÊU CẦU THIẾT KẾ RIÊNG  (FR-07, FR-08, mục 3.2)
// ---------------------------------------------------------------------

model CustomOrder {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerName String    @map("customer_name") @db.VarChar(100)
  phone        String    @db.VarChar(20)

  title        String    @db.VarChar(150)
  nailShape    NailShape @map("nail_shape")
  nailLength   NailLength @map("nail_length")
  nailSize     NailSize? @map("nail_size")
  colorPattern String?   @map("color_pattern") @db.Text
  customNotes  String?   @map("custom_notes") @db.Text
  budgetMin    Decimal?  @map("budget_min") @db.Decimal(12, 0)
  budgetMax    Decimal?  @map("budget_max") @db.Decimal(12, 0)
  desiredDate  DateTime? @map("desired_date") @db.Date

  status       CustomOrderStatus @default(SUBMITTED)

  quotedPrice       Decimal?  @map("quoted_price") @db.Decimal(12, 0)
  quoteNote         String?   @map("quote_note") @db.Text
  quoteLeadTimeDays Int?      @map("quote_lead_time_days")
  quotedAt          DateTime? @map("quoted_at")
  agreedPrice       Decimal?  @map("agreed_price") @db.Decimal(12, 0)
  respondedAt       DateTime? @map("responded_at")
  rejectionReason   String?   @map("rejection_reason") @db.Text

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  images    CustomOrderImage[]
  messages  CustomOrderMessage[]
  order     Order?
  emailLogs EmailLog[]

  @@index([userId])
  @@index([status])
  @@map("custom_orders")
}

model CustomOrderImage {
  id            Int         @id @default(autoincrement())
  customOrderId Int         @map("custom_order_id")
  customOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  imageUrl      String      @map("image_url")
  mimeType      String      @map("mime_type") @db.VarChar(50)
  sizeBytes     Int         @map("size_bytes")
  sortOrder     Int         @default(1) @map("sort_order")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([customOrderId, sortOrder])
  @@map("custom_order_images")
}

model CustomOrderMessage {
  id            Int         @id @default(autoincrement())
  customOrderId Int         @map("custom_order_id")
  customOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)
  senderId      Int         @map("sender_id")
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body          String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([customOrderId, createdAt])
  @@map("custom_order_messages")
}

// ---------------------------------------------------------------------
// 8. EMAIL THÔNG BÁO  (FR-16, mục 3.5)
// ---------------------------------------------------------------------

model EmailLog {
  id            Int          @id @default(autoincrement())
  type          EmailType
  toEmail       String       @map("to_email")
  subject       String       @db.VarChar(255)
  status        EmailStatus  @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.Text
  userId        Int?         @map("user_id")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId       Int?         @map("order_id")
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customOrderId Int?         @map("custom_order_id")
  customOrder   CustomOrder? @relation(fields: [customOrderId], references: [id], onDelete: SetNull)
  sentAt        DateTime?    @map("sent_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([orderId])
  @@index([customOrderId])
  @@map("email_logs")
}

// ---------------------------------------------------------------------
// 9. NGOÀI TÀI LIỆU YÊU CẦU (FR-01..FR-16 không nhắc tới) - GIỮ NGUYÊN
// ---------------------------------------------------------------------

model Appointment {
  id              Int               @id @default(autoincrement())
  userId          Int?              @map("user_id")
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String            @map("customer_name") @db.VarChar(100)
  phone           String            @db.VarChar(20)
  serviceName     String            @map("service_name")
  appointmentDate DateTime          @map("appointment_date")
  status          AppointmentStatus @default(PENDING)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([appointmentDate])
  @@index([status])
  @@index([userId])
  @@map("appointments")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}
